 """Text helper tests."""
 
-from src.text import titlecase
+import pytest
+
+from src.text import titlecase, truncate
 
 
 def test_titlecases_every_word() -> None:
     assert titlecase("hello world") == "Hello World"
+
+
+@pytest.mark.parametrize(
+    ("text", "limit", "expected"),
+    [
+        ("abcdef", 4, "a..."),
+        ("abc", 3, "abc"),
+        ("abcdef", 3, "..."),
+        ("abcdef", 2, ".."),
+        ("abcdef", 0, ""),
+    ],
+)
+def test_truncate_never_exceeds_limit(
+    text: str, limit: int, expected: str
+) -> None:
+    result = truncate(text, limit)
+
+    assert result == expected
+    assert len(result) <= limit
+
+
+def test_truncate_rejects_negative_limit() -> None:
+    with pytest.raises(ValueError, match="non-negative"):
+        truncate("abcdef", -1)
