-    for attempt in range(1, 3):
+    for attempt in range(1, 4):
         if sink():
             return attempt
-    return 2
+    return 3
--- a/tests/test_sender.py
+++ b/tests/test_sender.py
@@ -5,3 +5,21 @@
 
 def test_stops_on_first_success() -> None:
     assert send_with_retry(lambda: True) == 1
+
+
+def test_succeeds_on_third_attempt() -> None:
+    results = iter((False, False, True))
+
+    assert send_with_retry(lambda: next(results)) == 3
+
+
+def test_gives_up_after_three_attempts() -> None:
+    attempts = 0
+
+    def sink() -> bool:
+        nonlocal attempts
+        attempts += 1
+        return False
+
+    assert send_with_retry(sink) == 3
+    assert attempts == 3
